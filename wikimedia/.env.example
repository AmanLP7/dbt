# Template for the runtime configuration. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real values.
#
# Any value left at its placeholder (containing `your_`) is rejected by the
# consumer at startup, so a half-configured copy fails loudly instead of
# silently.

# Databricks workspace. http_path is the HTTP path of the SQL warehouse
# (SQL warehouses -> your warehouse -> Connection details).
DATABRICKS_HOSTNAME=your_workspace_host
DATABRICKS_HTTP_PATH=your_http_path

# Optional. Which profile in ~/.databrickscfg to authenticate with. The consumer
# and the dbt batch layer both use it, so one
# `databricks auth login --profile <name>` covers the whole pipeline.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Optional. Log level for the consumer (default INFO).
LOG_LEVEL=INFO

# Optional. Where the resume checkpoint lives (default .state/last_event_id.json).
# The consumer needs no Wikimedia credential: the EventStreams firehose is public.
# WIKIMEDIA_STATE_FILE=.state/last_event_id.json
