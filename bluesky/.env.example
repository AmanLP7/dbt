# Template for the runtime configuration. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real values.
#
# Any required value left at its placeholder (containing `your_`) is rejected at
# startup, so a half-configured copy fails loudly instead of connecting to the
# wrong workspace.

# Databricks workspace. http_path is the HTTP path of the SQL warehouse
# (SQL warehouses -> your warehouse -> Connection details).
DATABRICKS_HOSTNAME=your_workspace_host
DATABRICKS_HTTP_PATH=your_http_path

# Optional. Which profile in ~/.databrickscfg to authenticate with. Both the
# loader and dbt use it, so one `databricks auth login --profile <name>` covers
# the whole pipeline. Defaults to DEFAULT.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Optional. Log level for the loader (default INFO).
LOG_LEVEL=INFO

# Optional. Path to the SQLite database the Bluesky flow writes. Defaults to
# ../kafka_streams/bluesky/data/bluesky.db relative to this project, which is
# where the Flink job in kafka_streams/bluesky/ puts it. Point this elsewhere to
# load a snapshot taken on another machine.
# BLUESKY_SQLITE_PATH=/path/to/bluesky.db

# Optional. Minted by hand for a manual `dbt build`; the loader mints its own
# token from the CLI profile and never reads this.
# DATABRICKS_TOKEN=
