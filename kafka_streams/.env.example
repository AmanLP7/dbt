# Shared configuration for every flow under kafka_streams/. Copy to `.env` and
# fill in. `.env` is gitignored — never commit real values.
#
# Each flow loads this file through `python-dotenv`, which walks up from the
# calling module, so running `python -m …` from inside a flow directory still
# finds it. Flow-specific keys go here too, prefixed with the flow name.

# Kafka bootstrap address. The compose file in this folder advertises
# localhost:9092 for clients on the host.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- wikimedia flow ---------------------------------------------------------

# Optional. SQLite sink path (default: wikimedia/data/wikimedia.db relative to
# the repo root). A relative value resolves against the flow directory
# (kafka_streams/wikimedia/), not the shell's cwd.
# WIKIMEDIA_SQLITE_PATH=data/wikimedia.db

# Optional. Log level for producer and consumer (default INFO).
# LOG_LEVEL=INFO

# --- bluesky flow -----------------------------------------------------------

# Optional. SQLite sink path (default: bluesky/data/bluesky.db relative to the
# repo root). A relative value resolves against the flow directory
# (kafka_streams/bluesky/), not the shell's cwd.
# BLUESKY_SQLITE_PATH=data/bluesky.db

# Optional. Jetstream endpoint (default: the public v2 firehose). Override it to
# point at a self-hosted jetstream binary, which serves the same protocol.
# The flow speaks v2: `?cursor=` takes either a `seq` or a microsecond timestamp.
# BLUESKY_JETSTREAM_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents

# Optional. Port for the Flink dashboard of the bluesky job (default 8082; the
# wikimedia job holds 8081).
# BLUESKY_FLINK_REST_PORT=8082
