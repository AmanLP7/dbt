# Template for the runtime configuration. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real values.
#
# Any value left at its placeholder (containing `your_`) is rejected by the
# extractor at startup, so a half-configured copy fails loudly instead of
# silently.
#
# The three job sources — remotive, arbeitnow and jobicy — are keyless HTTP JSON
# APIs: no API key, token or account of any kind. Nothing below this line is
# per-source configuration, so the Databricks values are the only settings this
# pipeline requires.

# Databricks workspace. http_path is the HTTP path of the SQL warehouse
# (SQL warehouses -> your warehouse -> Connection details).
DATABRICKS_HOSTNAME=your_workspace_host
DATABRICKS_HTTP_PATH=your_http_path

# Optional. Which profile in ~/.databrickscfg the Databricks CLI reads. Both
# halves of the pipeline authenticate through it — the extractor by handing the
# SQL connector a credentials provider, the orchestrated dbt step by minting a
# token per run — so one `databricks auth login --profile <name>` covers ingestion
# and dbt, and nothing here needs a token that expires.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Optional. Log level for the extractor (default INFO).
LOG_LEVEL=INFO

# Not used. Neither the extractor nor the orchestrated dbt run reads a token from
# the environment: the CLI profile above refreshes its own. Set it only when
# running `dbt` by hand with DBT_PROFILES_DIR=profiles, whose committed profile
# requires it:
#   export DATABRICKS_TOKEN=$(databricks auth token --output json | jq -r .access_token)
# DATABRICKS_TOKEN=

# Optional. Override the catalog/schema the raw table is created in
# (workspace.job_postings.raw_job_postings). Read by raw_table_fqn() in
# ingestion/jobs/_common.py, and by the `jobs` dbt source in
# models/staging/jobs/src_jobs.yml, so both halves stay pointed at the same table.
# Leave unset unless you are writing the raw data somewhere else.
# JOB_POSTINGS_CATALOG=workspace
# JOB_POSTINGS_SCHEMA=job_postings
